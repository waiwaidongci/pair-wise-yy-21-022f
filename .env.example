COMPOSE_PROJECT_NAME=grid-repair
FRONTEND_PORT=20104
BACKEND_PORT=21104
DB_PORT=33060
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=app_db
JWT_SECRET=local-dev-secret
# 调度台：派工占用名额的有效期（毫秒），超时自动释放
DISPATCH_HOLD_TTL_MS=120000
# 调度台：状态落盘文件（容器内路径），默认 backend/data/dispatch-state.json
# DISPATCH_STATE_FILE=/app/data/dispatch-state.json
